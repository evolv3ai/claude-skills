# Fork Configuration
# Copy to .env and customize for your fork
#
# PLUGIN_AUTHOR_NAME: Your name or org (used in plugin.json author field)
# PLUGIN_AUTHOR_EMAIL: Your contact email
# PLUGIN_REPOSITORY: Your fork's URL (GitHub or other)
# SKILL_PATHS: Comma-separated list of skills YOU authored (gets your author info)
#   Skills NOT in this list get upstream author info (Jeremy Dawes / jezweb)

PLUGIN_AUTHOR_NAME="Your Name"
PLUGIN_AUTHOR_EMAIL="your@email.com"
PLUGIN_REPOSITORY="https://github.com/your-org/claude-skills"

# Example: SKILL_PATHS=my-skill,another-skill,admin-custom
SKILL_PATHS=
